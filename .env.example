# Copy to .env (git-ignored). Services and the platform load it automatically.

# --- Demo services ---
# Where services send their logs (the platform ingest API). Empty = stdout only.
LOG_INGEST_URL=http://localhost:4000/api/v1/logs
# Where the bad_deploy fault records its deploy (like a CI/CD webhook). Empty = not recorded.
DEPLOY_WEBHOOK_URL=http://localhost:4000/api/v1/deploys
# json | pretty
LOG_FORMAT=pretty
LOG_LEVEL=info
DEPLOY_ENV=local

ORDER_SERVICE_PORT=4001
PAYMENT_SERVICE_PORT=4002
GATEWAY_MOCK_PORT=4003
PAYMENT_SERVICE_URL=http://localhost:4002
GATEWAY_URL=http://localhost:4003

# --- Platform ---
PLATFORM_PORT=4000
DATABASE_URL=postgresql://analyzer:analyzer@localhost:5432/analyzer?schema=public
OPENSEARCH_URL=http://localhost:9200
KAFKA_BROKERS=localhost:19092
# Detector: how often it re-checks the 1-minute windows.
DETECT_INTERVAL_MS=15000
