{
  "name": "ai-analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "AI Log Analyzer & Incident Assistant: OTel log ingestion, anomaly detection and an LLM root-cause investigator.",
  "workspaces": [
    "packages/*",
    "services/*",
    "tools/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "npm install && npm run infra:up && npm run db:deploy",
    "dev:services": "concurrently -n gateway,payment,order -c magenta,yellow,cyan \"npm:dev:gateway\" \"npm:dev:payment\" \"npm:dev:order\"",
    "dev:platform": "concurrently -n api,worker -c green,blue \"npm:dev:api\" \"npm:dev:worker\"",
    "dev:all": "concurrently -n gateway,payment,order,api,worker,ui -c magenta,yellow,cyan,green,blue,white \"npm:dev:gateway\" \"npm:dev:payment\" \"npm:dev:order\" \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:dashboard\"",
    "dev:gateway": "npm run dev -w @ai-analyzer/gateway-mock",
    "dev:payment": "npm run dev -w @ai-analyzer/payment-service",
    "dev:order": "npm run dev -w @ai-analyzer/order-service",
    "dev:api": "npm run dev:api -w @ai-analyzer/platform",
    "dev:worker": "npm run dev:worker -w @ai-analyzer/platform",
    "traffic": "npm run start -w @ai-analyzer/traffic-generator --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @ai-analyzer/platform",
    "db:deploy": "npm run db:deploy -w @ai-analyzer/platform",
    "docs:postman": "node scripts/build-postman.cjs",
    "eval": "npm run start -w @ai-analyzer/eval --",
    "dev:dashboard": "npm run dev -w @ai-analyzer/dashboard",
    "loadtest": "node scripts/loadtest.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
